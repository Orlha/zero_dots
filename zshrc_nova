HISTFILE="$HOME/.cache/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt SHARE_HISTORY
setopt HIST_IGNORE_SPACE
setopt HIST_SAVE_NO_DUPS
setopt HIST_REDUCE_BLANKS

if [ "$TERM" = "linux" ]; then
    PS1='%n@%m:%~$ '
    return 0
fi

export ZSH_COMPDUMP="$HOME/.cache/zcompdump"
#setopt PROMPT_SUBST

#######################

setopt PROMPT_SUBST

autoload -Uz vcs_info
precmd() {
    vcs_info
    if [[ -n "$SSH_CLIENT" || -n "$SSH_CONNECTION" ]]; then
        # Over SSH: User › Globe Host
        ssh_block='%F{#a3e635}%n%f %F{#b2b2b2}›%f %F{#a3e635}🌍 %m%f '
    else
        # Local: Just User (No arrow needed here)
        ssh_block='%F{#a3e635}%n%f '
    fi
}

# RPROMPT: Golden Orange Seedling & Branch
zstyle ':vcs_info:git:*' formats ' %F{#f39c12}🌱 %b%f'
zstyle ':vcs_info:git:*' actionformats ' %F{#f39c12}🌱 %b|%a%f'

# PROMPT: SSH block, › , GOLDEN ORANGE Path, ARROW (Green=Success, Soft Red=Fail)
if [[ -n "$SSH_CLIENT" || -n "$SSH_CONNECTION" ]]; then
    PROMPT='${ssh_block}%F{#b2b2b2}›%f %F{#f39c12}%~%f %(?.%F{#a3e635}➜.%F{#e06c75}➜)%f '
else
    PROMPT='${ssh_block}%F{#f39c12}%~%f %(?.%F{#a3e635}➜.%F{#e06c75}➜)%f '
fi

RPROMPT='${vcs_info_msg_0_}'

#######################

#PROMPT='%F{141}%~ %F{117}❯%f '

export XCURSOR_THEME=breeze_cursors
export XCURSOR_SIZE=24
export COLORTERM=truecolor

autoload -Uz compinit
compinit -d "$ZSH_COMPDUMP"
zstyle ':completion:*' menu select

alias ls='ls --color=auto'
alias ip='ip -c=auto'
alias poweroff='poweroff --no-wall'
alias reboot='reboot --no-wall'
alias nnn='nnn -e'
alias mpv='mpv --hwdec=vaapi --vo=gpu-next'

export EDITOR=nvim
export PATH=$HOME/.local/bin:$PATH
export GPG_TTY=$(tty)
export GOPASS_CLIPBOARD_COPY_CMD="$HOME/.local/bin/osc52-copy.sh"

set -o emacs
tabs 4

eval "$(zoxide init zsh)"

distro=$(grep ^ID= /etc/os-release)
if [[ $distro == "ID=ubuntu" ]]; then
    source /usr/share/zsh-antigen/antigen.zsh
else
    source /usr/share/zsh/share/antigen.zsh
fi

antigen use oh-my-zsh
antigen bundle sudo
antigen bundle colored-man-pages
antigen bundle command-not-found
antigen bundle zsh-users/zsh-syntax-highlighting
antigen bundle zsh-users/zsh-autosuggestions
antigen apply

# unbind alt+l that zsh binds
bindkey -r "^[l"

bindkey  "^[[1~"   beginning-of-line
bindkey  "^[[4~"   end-of-line
bindkey "^[[3~" delete-char
bindkey "^[[2~" overwrite-mode
bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line
bindkey "^[[5~" history-search-backward
bindkey "^[[6~" history-search-forward
bindkey '^k' up-line-or-history
bindkey '^j' down-line-or-history

bindkey -r "^[OP"
bindkey -r "^[OQ"
bindkey -r "^[OR"
bindkey -r "^[OS"
bindkey -r "^[[15~"
bindkey -r "^[[17~"
bindkey -r "^[[18~"
bindkey -r "^[[19~"
bindkey -r "^[[20~"
bindkey -r "^[[21~"
bindkey -r "^[[23~"
bindkey -r "^[[24~"

bindkey -s "^[OP" ""
bindkey -s "^[OQ" ""
bindkey -s "^[OR" ""
bindkey -s "^[OS" ""
bindkey -s "^[[15~" ""
bindkey -s "^[[17~" ""
bindkey -s "^[[18~" ""
bindkey -s "^[[19~" ""
bindkey -s "^[[20~" ""
bindkey -s "^[[21~" ""
bindkey -s "^[[23~" ""
bindkey -s "^[[24~" ""

bindkey -s "^[[25~" "\e["
bindkey -s "^[[26~" "\e]"

source <(fzf --zsh)

typeset -A ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[comment]='fg=244'
